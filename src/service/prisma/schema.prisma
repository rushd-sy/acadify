generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id])
  studentSections StudentSection[]

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}

model Teacher {
  userId Int @id
  degree String
  user User @relation(fields: [userId], references: [id])
  sectionCurriculumTeachers SectionCurriculumTeacher[]

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}

model User {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  phoneNumber    String   @unique
  email          String   @unique
  hashedPassword String
  student        Student?
  teacher        Teacher?

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}

model Grade {
  id       Int       @id @default(autoincrement())
  name     String
  sections Section[]

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}

model Curriculum {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  sectionCurriculumTeachers SectionCurriculumTeacher[]

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}

model Section {
  id           Int    @id @default(autoincrement())
  name         String
  academicYear String
  gradeId      Int

  grade                       Grade  @relation(fields: [gradeId], references: [id])
  sectionCurriculumTeachers   SectionCurriculumTeacher[]
  studentSections             StudentSection[]
  examSections                ExamSection[]

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}


model Exam {
  id       Int      @id @default(autoincrement())
  examTemplateId Int?
  title          String
  date           DateTime
  curriculumId   Int?
  documentUrl        String?
  minScore       Float
  maxScore       Float

  examSections   ExamSection[]

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}


model SectionCurriculumTeacher {
  id Int @id @default(autoincrement())
  userId Int 
  curriculumId Int 
  sectionId Int

  teacher Teacher @relation(fields: [userId], references: [userId])
  curriculum Curriculum @relation(fields: [curriculumId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?
}



model StudentSection {
  id Int @id @default(autoincrement())
  studentId Int 
  sectionId Int 
  startDate DateTime @default(now())
  endDate DateTime?

  student Student @relation(fields: [studentId], references: [userId])
  section Section @relation(fields: [sectionId], references: [id])

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?

  @@unique([studentId, sectionId])
}

model ExamSection {
  id Int @id @default(autoincrement())
  examId Int
  sectionId Int

  exam Exam @relation(fields: [examId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  createdAt      DateTime @default(now())
  createdBy      Int
  updatedAt      DateTime?  @updatedAt
  updatedBy      Int?
  archivedAt     DateTime?  

  @@unique([examId, sectionId])
  @@index([sectionId])
}
