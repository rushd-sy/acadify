generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id])
}

model Teacher {
  userId Int @id
  degree String
  user User @relation(fields: [userId], references: [id])
  teacherCurriculums TeacherCurriculum[]
}

model User {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  phoneNumber    String   @unique
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student?
  teacher        Teacher?
}

model Grade {
  id       Int       @id @default(autoincrement())
  name     String
  sections Section[]
}

model Curriculum {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  teacherCurriculums TeacherCurriculum[]
}

model Section {
  id           Int    @id @default(autoincrement())
  name         String
  academicYear String
  gradeId      Int
  grade        Grade  @relation(fields: [gradeId], references: [id])
  teacherCurriculums TeacherCurriculum[]
}

model TeacherCurriculum {
  id Int @id @default(autoincrement())
  userId Int 
  curriculumId Int 
  sectionId Int

  teacher Teacher @relation(fields: [userId], references: [userId])
  curriculum Curriculum @relation(fields: [curriculumId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
}
