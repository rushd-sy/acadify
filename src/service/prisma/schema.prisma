generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id])
  studentSections StudentSection[]
}

model Teacher {
  userId Int @id
  degree String
  user User @relation(fields: [userId], references: [id])
  sectionCurriculumTeachers SectionCurriculumTeacher[]
}

model User {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  phoneNumber    String   @unique
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student?
  teacher        Teacher?
}

model Grade {
  id       Int       @id @default(autoincrement())
  name     String
  sections Section[]
}

model Curriculum {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  sectionCurriculumTeachers SectionCurriculumTeacher[]
}

model Section {
  id           Int    @id @default(autoincrement())
  name         String
  academicYear String
  gradeId      Int
  grade        Grade  @relation(fields: [gradeId], references: [id])
  sectionCurriculumTeachers SectionCurriculumTeacher[]
  studentSections StudentSection[]
}


model Exam {
  id       Int      @id @default(autoincrement())
  examTemplateId Int?
  title          String
  date           DateTime
  curriculumId   Int?
  documentUrl        String?
  minScore       Float
  maxScore       Float
}


model SectionCurriculumTeacher {
  id Int @id @default(autoincrement())
  userId Int 
  curriculumId Int 
  sectionId Int

  teacher Teacher @relation(fields: [userId], references: [userId])
  curriculum Curriculum @relation(fields: [curriculumId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([userId, sectionId])
}



model StudentSection {
  id Int @id @default(autoincrement())
  studentId Int 
  sectionId Int 
  startDate DateTime @default(now())
  endDate DateTime?

  student Student @relation(fields: [studentId], references: [userId])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([studentId, sectionId])
}
